// ============================================================
// ERP System - Prisma Schema
// Modules: Students, Courses, Groups, Sessions, Attendance,
// Payments, Payroll, Expenses, CRM, Branches, Rooms,
// Scheduling, Inventory, Notifications, RBAC, Audit Logs
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// RBAC / USERS
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  RECEPTION
  INSTRUCTOR
  ACCOUNTANT
  PARENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  password      String
  role          UserRole
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // relations depending on role
  instructor    Instructor?
  parentOf      Student[]        @relation("ParentUser")
  leadsAssigned Lead[]           @relation("AssignedEmployee")
  auditLogs     AuditLog[]
  notifications Notification[]
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])

  @@index([role])
  @@map("users")
}

// ============================================================
// BRANCHES & ROOMS
// ============================================================

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rooms       Room[]
  users       User[]
  students    Student[]
  instructors InstructorBranch[]
  expenses    Expense[]
  inventory   InventoryItem[]

  @@map("branches")
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("rooms")
}

// ============================================================
// STUDENTS
// ============================================================

model Student {
  id            String    @id @default(cuid())
  fullName      String
  age           Int?
  birthDate     DateTime?
  school        String?
  guardianName  String?
  fatherPhone   String?
  motherPhone   String?
  whatsapp      String?
  address       String?
  notes         String?
  photoUrl      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])

  parentUserId  String?
  parentUser    User?     @relation("ParentUser", fields: [parentUserId], references: [id])

  enrollments   Enrollment[]
  payments      Payment[]
  attendances   Attendance[]
  leads         Lead[]

  @@index([branchId])
  @@map("students")
}

// ============================================================
// COURSES / GROUPS / ENROLLMENTS
// ============================================================

enum CourseStatus {
  ACTIVE
  PAUSED
  FINISHED
}

model Course {
  id          String       @id @default(cuid())
  name        String       // English, Programming, Robotics...
  description String?
  createdAt   DateTime     @default(now())

  enrollments Enrollment[]
  attendances Attendance[]

  @@map("courses")
}

model Enrollment {
  id                 String   @id @default(cuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt         DateTime @default(now())
  isActive           Boolean  @default(true)
  subscribedSessions Int?     // عدد السيشنات اللي الطالب اشترك فيها في الكورس ده
  paidAmount         Decimal? @db.Decimal(10, 2) // المبلغ اللي اتدفع وقت الاشتراك

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String           @id @default(cuid())
  courseId  String?
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @default(now())
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())

  @@index([studentId])
  @@index([courseId])
  @@map("attendances")
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
  OVERDUE
}

model Payment {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month          String        // "2026-07"
  amount         Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  remaining      Decimal       @default(0) @db.Decimal(10, 2)
  dueDate        DateTime
  paidAt         DateTime?     // تاريخ الدفع الفعلي
  sessionsCovered Int?         // عدد السيشنات اللي الدفعة دي بتغطيها
  paymentMethod  PaymentMethod?
  receiptNumber  String?
  status         PaymentStatus @default(DUE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// INSTRUCTORS & PAYROLL
// ============================================================

model Instructor {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratePerSession Decimal  @db.Decimal(10, 2)
  specialty      String?
  rating         Float?
  createdAt      DateTime @default(now())

  branches       InstructorBranch[]
  payrolls       Payroll[]

  @@map("instructors")
}

model InstructorBranch {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([instructorId, branchId])
  @@map("instructor_branches")
}

model Payroll {
  id             String   @id @default(cuid())
  instructorId   String
  instructor     Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  month          String   // "2026-07"
  sessionsCount  Int
  baseAmount     Decimal  @db.Decimal(10, 2)
  bonus          Decimal  @default(0) @db.Decimal(10, 2)
  penalty        Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  notes          String?
  generatedAt    DateTime @default(now())
  pdfUrl         String?

  @@unique([instructorId, month])
  @@map("payrolls")
}

// ============================================================
// EXPENSES
// ============================================================

enum ExpenseCategory {
  RENT
  SALARIES
  BILLS
  EQUIPMENT
  MARKETING
  WATER
  ELECTRICITY
  INTERNET
  MAINTENANCE
  MISC
}

model Expense {
  id        String          @id @default(cuid())
  branchId  String?
  branch    Branch?         @relation(fields: [branchId], references: [id])
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())

  @@index([category])
  @@index([date])
  @@map("expenses")
}

// ============================================================
// CRM / LEADS
// ============================================================

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  REFERRAL
  WEBSITE
  WALK_IN
}

enum LeadStatus {
  INTERESTED
  CALLED
  TRIAL
  REGISTERED
  LOST
}

model Lead {
  id                 String     @id @default(cuid())
  name               String
  phone              String?
  source             LeadSource
  status             LeadStatus @default(INTERESTED)
  assignedEmployeeId String?
  assignedEmployee   User?      @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  followUpDate       DateTime?
  notes              String?
  studentId          String?
  student            Student?   @relation(fields: [studentId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@map("leads")
}

// ============================================================
// INVENTORY
// ============================================================

enum InventoryStatus {
  AVAILABLE
  BROKEN
  LOST
}

model InventoryItem {
  id        String          @id @default(cuid())
  name      String          // Robotics Kits, Arduino, Laptop...
  branchId  String?
  branch    Branch?         @relation(fields: [branchId], references: [id])
  quantity  Int
  available Int
  broken    Int             @default(0)
  lost      Int             @default(0)
  createdAt DateTime        @default(now())

  @@map("inventory_items")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  PAYMENT_OVERDUE
  SESSION_TODAY
  BIRTHDAY
  SUBSCRIPTION_ENDING
  REPEATED_ABSENCE
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // "CREATE", "UPDATE", "DELETE"
  entityType String   // "Student", "Payment", ...
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
